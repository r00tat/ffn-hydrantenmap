rules_version = '2';

function authorizedUser() {
  return request.auth != null && (

    (request.auth.token.email_verified == true && request.auth.token.email.matches(".*@ff-neusiedlamsee\\.at")) ||
    request.auth.token.authorized == true
    );
}


// Craft rules based on data in your Firestore database
// allow write: if firestore.get(
//    /databases/(default)/documents/users/$(request.auth.uid)).data.isAdmin;
//
// Diese Datei wird über terraform ausgerollt
// (`google_firebaserules_ruleset`/`_release` in
// terraform/modules/project-base/firebase.tf), nicht über `firebase deploy` —
// in `firebase.json` steht sie deshalb bewusst nicht.
//
// Die Regeln gelten für den Default-Bucket `<projekt>.appspot.com`, den es je
// Projekt genau einmal gibt und den sich dev und prod derzeit teilen. Sie
// liegen deshalb im Projekt-Root (terraform/projects/<projekt-id>), der bei
// jedem Push auf main vor dem Deploy appliziert wird — eine Änderung hier ist
// mit dem nächsten Merge wirksam.
service firebase.storage {
  match /b/{bucket}/o {
  	match /firecall/{firecallId}/files/{fileName} {
    	allow read, write: if authorizedUser();
    }

    match /bugReports/{reportId}/{fileName} {
      allow create: if authorizedUser();
      allow read: if false;  // nur Admin SDK liest Anhänge (Admin-UI lädt signed URLs server-seitig)
    }

    // Bilder zu einem Fahrzeugmangel.
    //
    // Lesen ist auch für angemeldete Benutzer gesperrt: Ob jemand die Bilder
    // sehen darf, hängt an der Mitgliedschaft in der Gruppe, und die steht in
    // Firestore. Ein `firestore.get` aus einer Storage-Regel trifft immer die
    // Default-Datenbank und gäbe in der Dev-Datenbank `ffndev` die falsche
    // Antwort. Deshalb prüft die Server Action `mangelImageUrls` die
    // Mitgliedschaft und gibt kurzlebige Signed URLs heraus — wie bei den
    // Bug-Report-Anhängen.
    //
    // Nur `create`: Ein Dateiname trägt eine UUID, es gibt also nichts zu
    // überschreiben. Gelöscht wird ausschließlich serverseitig, wenn ein Bild
    // aus dem Mangel entfernt oder der Mangel gelöscht wird.
    //
    // Die Schranke für Größe und Typ steht hier, und nur hier: Die
    // clientseitige Verkleinerung (`compressImage`) ist eine Bequemlichkeit —
    // wer den Upload direkt aufruft, kommt an ihr vorbei.
    //
    // Der Browser prüft dieselben beiden Bedingungen trotzdem vor dem Upload
    // (`prepareMangelImage` gegen `MANGEL_MAX_IMAGE_BYTES` und
    // `isAllowedMangelImageType` in `src/common/mangel.ts`), damit der Melder
    // erfährt, welches Foto zu groß war. Ohne das antwortet der Storage nur
    // mit `storage/unauthorized`. Wer die 15 MB hier ändert, ändert die
    // Konstante mit — ein Test in `src/common/mangel.test.ts` liest diese
    // Datei und vergleicht beide.
    match /groups/{groupId}/mangel/{mangelId}/{fileName} {
      allow create: if authorizedUser()
        && request.resource.size < 15 * 1024 * 1024
        && request.resource.contentType.matches('image/.*');
      allow read, update, delete: if false;
    }

    // Terrain-Kacheln des eigenen Höhenmodells.
    //
    // Lesen ohne Anmeldung ist Absicht und die einzige Ausnahme in dieser
    // Datei. Zwei Gründe:
    //
    // Es sind offene Geodaten — BEV ALS-DGM unter CC BY 4.0, unverändert
    // umkodiert. Es gibt keinen Vertraulichkeitsgrund; die Namensnennung
    // erfolgt in der Legende und auf der Datenschutzseite.
    //
    // Und es sind über 4.000 Kacheln. Ein authentifizierter Zugriff bräuchte
    // je Kachel ein Download-Token, das mit dem Service-Worker-Cache nicht
    // vereinbar ist: die URL müsste je Sitzung anders lauten und der Cache
    // liefe leer. Genau dieser Cache trägt aber den Hochwasserfall, in dem das
    // Netz schlecht ist.
    //
    // Geschrieben wird ausschließlich über das Admin-SDK im Import-Skript
    // (`npm run terrainImport`), nie aus der App.
    match /terrain/{allPaths=**} {
      allow read: if true;
      allow write: if false;
    }

    match /{allPaths=**} {
      allow read, write: if false;
    }
  }
}