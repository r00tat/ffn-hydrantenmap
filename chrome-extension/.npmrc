# See ../.npmrc for the rationale. npm does not read a parent project's .npmrc,
# so this sub-project needs its own copy.
#
# This also disables this package's own postinstall (`wxt prepare`). That is
# fine for the scripted paths: `npm test` and `npm run build` both run
# `wxt prepare` themselves as their first step. After a bare `npm install`,
# run `npx wxt prepare` if you need .wxt/ populated without building.
ignore-scripts=true
