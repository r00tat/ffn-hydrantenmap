{
  "mcpServers": {
    "firebase": {
      "command": "npx",
      "args": [
        "-y",
        "firebase-tools@latest",
        "mcp",
        "--dir",
        ".",
        "--only",
        "core,firestore,storage,auth,messaging,functions,remoteconfig,database,developerknowledge,crashlytics"
      ]
    },
    "einsatzkarte-local": {
      "type": "http",
      "url": "https://localhost:3000/api/mcp"
    }
  }
}
