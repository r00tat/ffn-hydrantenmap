# Block dependency lifecycle scripts. They run at install time, before anything
# has imported the package, which makes them the cheapest path to code execution
# in a supply-chain attack: a compromised transitive dependency only needs
# someone to type `npm install`.
#
# npm 11 does NOT block them on its own. It warns ("N packages have install
# scripts not yet covered by allowScripts") and points at `npm approve-scripts`,
# then runs the scripts anyway. This setting is what actually blocks them.
#
# Nothing in this tree needs them: no node-gyp, no prebuild-install, and the
# native bindings of sharp et al. ship as prebuilt platform packages via
# optionalDependencies.
#
# Scope: npm reads this file only for the project it sits in. Sub-projects with
# their own package.json need their own copy, so capacitor/ and
# chrome-extension/ each carry one.
#
# Side effect: `npm run <script>` still works, but its pre*/post* hooks no
# longer fire. No script here relies on one; if you add such a hook, chain it
# into the script body instead.
ignore-scripts=true
