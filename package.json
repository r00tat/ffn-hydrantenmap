    "@google-cloud/text-to-speech": "^7.0.0",
    "@google-cloud/vertexai": "^1.12.0",
    "@googleapis/drive": "^21.0.0",
    "@googleapis/gmail": "^18.0.0",
    "@googleapis/sheets": "^14.0.0",
    "@mapbox/togeojson": "^0.16.2",
    "@mdi/js": "^7.4.47",
