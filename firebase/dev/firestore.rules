rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
  
    function authorizedUser() {
      return request.auth != null && (
          (request.auth.token.email_verified == true && request.auth.token.email.matches(".*@ff-neusiedlamsee\\.at")) ||
          request.auth.token.authorized == true
          // get(/databases/$(database)/documents/user/$(request.auth.uid)).data.authorized in [true, 'on', 'yes', 'y']
        );
    }
    
    function adminUser() {
      return request.auth != null &&
      request.auth.token.isAdmin == true
      // get(/databases/$(database)/documents/user/$(request.auth.uid)).data.isAdmin == true;
    }

    function kostenersatzUser() {
      return authorizedUser() && 'kostenersatz' in request.auth.token.groups;
    }

    // Einsatz-Gäste kommen über einen Share-Link (/einsatz/<id>?token=…) und
    // tragen den Claim `firecall`. `firecallWrite` entscheidet, ob ihr Zugriff
    // auch Schreibrechte umfasst.
    // Fehlt der Claim komplett, gilt Schreibzugriff: Gäste, deren Link vor
    // Einführung dieses Feldes erzeugt wurde, behalten ihren bisherigen
    // Zugriff, bis ihr Token erneuert wurde (spätestens nach 45 Minuten, siehe
    // useFirebaseCustomTokenLogin.ts).
    function guestMayWrite() {
      return !('firecallWrite' in request.auth.token)
        || request.auth.token.firecallWrite == true;
    }

    // Der Ablauf eines Gastzugangs steckt als absoluter Zeitstempel im Token und
    // wird beim Refresh (alle 45 Min, siehe useFirebaseCustomTokenLogin.ts) neu
    // gesetzt. Fehlt der Claim, gilt kein Ablauf: Gruppenmitglieder tragen ihn
    // nie, und Gäste aus der Zeit vor der Link-Verwaltung verlieren ihren
    // Zugriff ohnehin beim nächsten Token-Tausch, weil ihr Benutzerdokument
    // kein Ablaufdatum hat.
    function guestNotExpired() {
      return !('firecallExpires' in request.auth.token)
        || request.auth.token.firecallExpires > request.time.toMillis();
    }
    
    match /hydrant/{doc=*} {
      allow read: if authorizedUser()
    }
    match /saugstelle/{doc=*} {
      allow read: if authorizedUser()
    }
    match /loeschteich/{doc=*} {
      allow read: if authorizedUser()
    }
    match /risikoobjekt/{doc=*} {
      allow read: if authorizedUser()
    }    
    match /gefahrobjekt/{doc=*} {
      allow read: if authorizedUser()
    }
    match /assistants/{doc=*} {
      allow read: if authorizedUser()
    }

    match /call/{doc} {
      allow read: if authorizedUser() 
            // && resource.data.group in get(/databases/$(database)/documents/user/$(request.auth.uid)).data.groups 
            && (
            	(doc == request.auth.token.firecall && guestNotExpired()) ||
              resource.data.group in request.auth.token.groups
            );
      allow write: if authorizedUser() 
            && (
            	(doc == request.auth.token.firecall && guestNotExpired() && guestMayWrite()) ||
              resource.data.group in request.auth.token.groups
            );
      allow create: if authorizedUser() 
          && request.resource.data.group in request.auth.token.groups;

      function callAuthorized() {
        return authorizedUser() && (
          (doc == request.auth.token.firecall && guestNotExpired()) ||
          get(/databases/$(database)/documents/call/$(doc)).data.group in request.auth.token.groups
        )
      }

      // Wie callAuthorized(), schließt aber Nur-Lese-Gäste aus.
      function callWriteAuthorized() {
        return authorizedUser() && (
          (doc == request.auth.token.firecall && guestNotExpired() && guestMayWrite()) ||
          get(/databases/$(database)/documents/call/$(doc)).data.group in request.auth.token.groups
        )
      }

      // Audit log: append-only, user field must match authenticated email
      match /auditlog/{entryId} {
        allow read: if callAuthorized();
        allow create: if callAuthorized()
          && request.resource.data.user == request.auth.token.email;
        // No update or delete allowed for audit log entries
      }

      // Live location sharing: read for any firecall-authorized user,
      // write/delete only for the doc owner whose UID equals the doc id.
      // Bewusst callAuthorized() statt callWriteAuthorized(): Die eigene
      // Standortfreigabe ist keine Bearbeitung des Einsatzes, sondern eine
      // Information an die Einsatzleitung — genau dafür sind Nur-Lese-Gäste
      // (externe Kräfte, Nachbarwehr) da. Dasselbe gilt für das Audit-Log
      // oben: append-only und nur zur Nachvollziehbarkeit.
      match /livelocation/{userId} {
        allow read: if callAuthorized();
        allow create: if callAuthorized()
          && userId == request.auth.uid
          && request.resource.data.uid == request.auth.uid;
        allow update: if callAuthorized()
          && userId == request.auth.uid
          && request.resource.data.uid == request.auth.uid;
        allow delete: if callAuthorized()
          && userId == request.auth.uid;
      }

      match /{subitem=**} {
        allow read: if callAuthorized();
        allow write: if callWriteAuthorized();
      }
      
    }
    
    match /clusters/{doc=**} {
      allow read: if authorizedUser();
    }

    match /clusters6/{doc=**} {
      allow read: if authorizedUser();
      allow write: if adminUser();
    }

    match /tokens/{doc=**} {
        allow read: if authorizedUser() && request.auth.uid == resource.data.owner;
        allow delete: if authorizedUser() && request.auth.uid == resource.data.owner;
        allow write: if authorizedUser() && request.auth.uid == request.resource.data.owner;
    }

    match /user/{doc=*} {
      allow read: if request.auth != null && request.auth.uid == doc
    }

    // Per-user UI settings (language, future preferences).
    // Readable and writable only by the owning user or an admin.
    match /userSettings/{userId} {
      allow read, write: if (request.auth != null && request.auth.uid == userId) || adminUser();
    }

    // Kostenersatz rate versions - read for kostenersatz group, write for admin
    match /kostenersatzVersions/{doc=**} {
      allow read: if kostenersatzUser();
      allow write: if adminUser();
    }

    // Kostenersatz rates - read for kostenersatz group, write for admin
    match /kostenersatzRates/{doc=**} {
      allow read: if kostenersatzUser();
      allow write: if adminUser();
    }

    // Kostenersatz templates - read/create for kostenersatz group, update/delete for owner or admin
    match /kostenersatzTemplates/{templateId} {
      allow read: if kostenersatzUser();
      allow create: if kostenersatzUser();
      allow update, delete: if kostenersatzUser() &&
        (resource.data.createdBy == request.auth.token.email || adminUser());
    }

    // Kostenersatz vehicles - read for any authorized user (the vehicle
    // list powers einsatz-side autocomplete via EinsatzortEditDialog and
    // is needed by every FF member), write for admin.
    match /kostenersatzVehicles/{doc=**} {
      allow read: if authorizedUser();
      allow write: if adminUser();
    }

    // Pegelstand stations - read for all authorized, write for admin
    match /pegelstand_stations/{doc=**} {
      allow read: if authorizedUser();
      allow write: if adminUser();
    }

    // BlaulichtSMS per-group credentials (encrypted passwords).
    // Access is only through server-side Admin SDK actions — no direct client reads intended.
    match /blaulichtsmsConfig/{doc=**} {
      allow read, write: if false;
    }

    // Fahrtenbuch-Konfiguration je Gruppe — derzeit die Empfänger der
    // Mangel-Benachrichtigung. Eine eigene Collection statt weiterer Felder am
    // Gruppen-Dokument, weil dort jedes Feld für jedes Gruppenmitglied lesbar
    // ist (siehe /groups/{groupId}) und eine Empfängeradresse das nicht sein
    // soll. Zugriff nur über Admin Server Actions.
    match /fahrtenbuchConfig/{doc=**} {
      allow read, write: if false;
    }

    // Basisordner im Google Drive je Gruppe. Wie die Nachbar-Collections nur
    // über Admin Server Actions erreichbar — die Ordner-ID ist zwar kein
    // Geheimnis, aber sie soll nicht von jedem Client änderbar sein.
    match /driveConfig/{doc=**} {
      allow read, write: if false;
    }

    // Bug reports: any authorized user may create their own report (createdBy
    // must match the auth token). Reads and modifications are admin-only.
    match /bugReport/{doc} {
      allow create: if authorizedUser()
        && request.resource.data.createdBy.uid == request.auth.uid
        && request.resource.data.createdBy.email == request.auth.token.email
        && request.resource.data.kind in ['bug', 'feature']
        && request.resource.data.status == 'open';
      allow read, update, delete: if adminUser();
    }

    // Kommentare und Verlaufseinträge zu einem Bug-Report. Sie enthalten
    // interne Notizen und laufen ausschließlich über die Server-Actions
    // (Admin SDK, actionAdminRequired) — kein Client liest oder schreibt hier.
    match /bugReport/{doc}/comments/{comment} {
      allow read, write: if false;
    }

    // Application configuration documents (e.g. bug report recipient list).
    // Access is only through server-side Admin SDK actions.
    match /appConfig/{doc=**} {
      allow read, write: if false;
    }

    // Fahrtenbuch: Stammdaten und Einträge je Gruppe.
    // Einträge werden über Server Actions geschrieben; die Regeln hier geben
    // keinem Client Schreibrechte. Achtung: der abschließende
    // match /{document=**} lässt Admins weiterhin direkt schreiben — Regeln
    // sind additiv, ein "allow ...: if false" kann das nicht zurücknehmen.
    match /groups/{groupId} {
      // 'allUsers' ist keine echte Gruppe, sondern ein Pseudo-Eintrag, der
      // jedem Benutzer in die Claims geschrieben wird (updateUser.ts) und den
      // auch Einsatz-Gasttokens tragen (actions/auth.ts). Als Fahrtenbuch-
      // Mandant darf er deshalb nie zählen.
      // 'kostenersatz' ist keine Feuerwehr, sondern eine Berechtigungsgruppe
      // ("Zugang zur Kostenersatz-Funktion") — siehe NON_TENANT_GROUP_IDS und
      // assertFahrtenbuchGroup() in authGuards.ts, dieselbe Sperre gilt dort.
      function fahrtenbuchMember() {
        return authorizedUser()
          && groupId != 'allUsers'
          && groupId != 'kostenersatz'
          && groupId in request.auth.token.groups;
      }

      // Das Gruppen-Dokument trägt neben Name und Beschreibung den Standort
      // des Feuerwehrhauses. Den braucht der Client, um im Fahrtenbuch die
      // Einsatzkilometer abzuschätzen. Jedes Feld dieses Dokuments ist damit
      // für jedes Gruppenmitglied lesbar. Geheimnisse und Konfiguration
      // gehören deshalb in eine eigene Collection (siehe blaulichtsmsConfig),
      // nicht hierher.
      // Schreiben nur über Server Actions; diese Regel gibt keinem Client
      // Schreibrechte — Admins schreiben weiterhin über den Catch-all am
      // Dateiende (siehe Kommentar oben).
      allow read: if fahrtenbuchMember();
      allow write: if false;

      match /person/{doc} {
        allow read: if fahrtenbuchMember();
        allow write: if adminUser();
      }

      match /vehicle/{doc} {
        allow read: if fahrtenbuchMember();
        allow write: if adminUser();
      }

      // Atemschutz-Ausrüstung der Gruppe — Flaschen, Masken, Pressluftatmer.
      // Wörtlich wie `vehicle`: Jedes Gruppenmitglied liest sie (der
      // Sammelplatz braucht sie zum Nachschlagen und Scannen), geschrieben
      // wird ausschließlich über Server Actions. Dass hier `adminUser()` steht
      // und nicht der Gruppen-Admin, ist deshalb ohne Wirkung: Die Rolle steckt
      // in keinem Custom Claim und ist für Regeln nicht sichtbar; wer schreiben
      // darf, entscheidet `actionGroupAdminRequired(groupId)`.
      match /atemschutzGeraet/{doc} {
        allow read: if fahrtenbuchMember();
        allow write: if adminUser();
      }

      // Füllprotokoll der Atemluftflaschen. Anders als `atemschutzGeraet`
      // darf hier *jedes Gruppenmitglied anlegen*: Wer füllt, protokolliert,
      // und das ist selten ein Admin. Geschrieben wird clientseitig und nicht
      // über eine Server Action, weil am Sammelplatz die Verbindung schlecht
      // ist — Firestore stellt Client-Schreibvorgänge offline zurück und
      // spielt sie nach, eine Server Action scheitert.
      // Einsatz-Gäste sind keine Gruppenmitglieder und damit außen vor; sie
      // können die Geräte-Stammdaten ohnehin nicht lesen.
      //
      // Ändern und Löschen sind enger als Anlegen (#761): nur die *eigene*
      // Zeile, und nur solange sie auf keiner Rechnung steht. Das Protokoll
      // ist ein Nachweis — vorher durfte jedes Mitglied jede fremde Zeile
      // ändern und löschen.
      //
      // Der Gruppen-Admin darf mehr, sieht diese Regel aber nicht: Seine
      // Rolle steckt in keinem Custom Claim (siehe berechtigungen.md). Er
      // korrigiert deshalb über `updateFremdeFuellung` /
      // `deleteFremdeFuellung` mit dem Admin SDK; dieselbe Prüfung steht dort
      // als `fuellungSperre`.
      //
      // `createdBy` beim Anlegen an den Aufrufer gebunden: Ohne diese
      // Bedingung schriebe ein manipulierter Client eine fremde uid hinein und
      // sperrte die Zeile für den, der sie zu sehen bekommt.
      match /atemschutzFuellung/{doc} {
        allow read: if fahrtenbuchMember();
        allow create: if fahrtenbuchMember()
          && request.resource.data.createdBy == request.auth.uid;
        allow update: if fahrtenbuchMember()
          && resource.data.createdBy == request.auth.uid
          && !('rechnungId' in resource.data)
          // Die Zeile darf nicht die Seite wechseln: weder den Erfasser
          // verlieren noch sich selbst eine Rechnung anhängen.
          && request.resource.data.createdBy == resource.data.createdBy
          && !('rechnungId' in request.resource.data);
        allow delete: if fahrtenbuchMember()
          && resource.data.createdBy == request.auth.uid
          && !('rechnungId' in resource.data);
      }

      // Verrechnung der Füllungen. Lesen setzt beides voraus: Mitgliedschaft
      // in dieser Feuerwehr *und* die Kostenersatz-Freischaltung — wörtlich
      // derselbe Satz wie `actionFuellungRechnungRequired(groupId)` in den
      // Server Actions. Dass hier zwei Bedingungen stehen, ist der Grund für
      // diesen Zuschnitt: Regel und Action können nicht auseinanderlaufen.
      //
      // Geschrieben wird ausschließlich serverseitig. `adminUser()` steht hier
      // wie bei `atemschutzGeraet` nur der Form halber — die Rolle des
      // Gruppen-Admins steckt in keinem Custom Claim und ist für Regeln nicht
      // sichtbar.
      match /atemschutzRechnung/{doc} {
        allow read: if fahrtenbuchMember() && kostenersatzUser();
        allow write: if adminUser();
      }

      match /atemschutzEmpfaenger/{doc} {
        allow read: if fahrtenbuchMember() && kostenersatzUser();
        allow write: if adminUser();
      }

      // Betreff- und Textvorlage, CC-Adresse, Bankverbindung, Vorgabetarif und
      // der Nummernkreis. Ein eigenes Dokument und nicht das Gruppen-Dokument:
      // Dessen Felder liest jedes Gruppenmitglied.
      match /atemschutzConfig/{doc} {
        allow read: if fahrtenbuchMember() && kostenersatzUser();
        allow write: if adminUser();
      }

      // Absender, Bankverbindung und Logo der Gruppe. Ein eigenes Dokument
      // und nicht das Gruppen-Dokument: Dessen Felder liest jedes
      // Gruppenmitglied.
      //
      // Lesen ohne `kostenersatzUser()` — anders als bei `atemschutzConfig`:
      // Die Kostenersatz-Oberfläche zeigt die Stammdaten-Lücken auch dem, der
      // nur rechnet. Geschrieben wird über `saveGroupStammdaten`; die echte
      // Grenze ist `actionGroupAdminRequired`.
      match /groupConfig/{doc} {
        allow read: if fahrtenbuchMember();
        allow write: if adminUser();
      }

      // Mailvorlagen des Kostenersatzes, je Gruppe. Vorher ein einzelnes
      // Dokument auf Wurzelebene.
      match /kostenersatzConfig/{doc} {
        allow read: if fahrtenbuchMember() && kostenersatzUser();
        allow write: if adminUser();
      }

      match /fahrtenbuch/{doc} {
        allow read: if fahrtenbuchMember();
        allow create, update, delete: if false;
      }

      // Mängel an Fahrzeugen. Jedes Gruppenmitglied darf sie lesen und über
      // die Server Actions bearbeiten — wer einen Mangel abarbeitet, ist
      // selten der, der ihn gemeldet hat. Geschrieben wird ausschließlich
      // serverseitig, damit Statuswechsel und Verlaufseinträge ihre Spur
      // (Autor, Zeitpunkt) nicht verlieren können.
      match /mangel/{doc} {
        allow read: if fahrtenbuchMember();
        allow create, update, delete: if false;
      }
    }

    // Der Token ist die Dokument-ID und damit das gesamte Geheimnis des
    // Share-Links. Er wird ausschließlich vom Admin SDK gelesen und
    // geschrieben; auch Admins holen ihn über eine Server Action. Die
    // Reihenfolge der Regeln spielt dabei keine Rolle — Regeln sind additiv:
    // Der abschließende Catch-all erlaubt Admins weiterhin Zugriff, dieser
    // Block erlaubt allen anderen nichts. Beides gilt gleichzeitig.
    match /fahrtenbuchShareLink/{token} {
      allow read, write: if false;
    }

    // Passkeys werden ausschließlich über Server Actions mit dem Admin SDK
    // gelesen und geschrieben — die Ceremony-Verifikation, der Replay-Schutz
    // über `lastChallenge` und die Counter-Fortschreibung dürfen nicht am
    // Server vorbei manipulierbar sein. Wie beim Share-Link gilt: Regeln sind
    // additiv, der abschließende Catch-all lässt Admins weiterhin lesen. Das
    // ist vertretbar, weil hier nur öffentliche Schlüssel liegen und kein
    // Geheimnis, mit dem sich jemand anmelden könnte.
    match /passkey/{credentialId} {
      allow read, write: if false;
    }

    // OAuth/MCP: Authorization-Server-Daten.
    //
    // Rein serverseitig. Hier liegen Client-Registrierungen, Authorization
    // Codes, Refresh Tokens (nur Hashes) und die Einwilligungen. Kein Client
    // hat hier etwas zu suchen — gelesen und geschrieben wird ausschließlich
    // über das Admin SDK. Wie bei `passkey` und `fahrtenbuchShareLink` gilt:
    // Regeln sind additiv, der abschließende Catch-all lässt Admins weiterhin
    // lesen. Das ist vertretbar, weil hier keine Geheimnisse im Klartext
    // stehen, sondern nur deren Hashes.
    match /oauthClients/{clientId} {
      allow read, write: if false;
    }
    match /oauthAuthCodes/{codeHash} {
      allow read, write: if false;
    }
    match /oauthRefreshTokens/{tokenHash} {
      allow read, write: if false;
    }
    match /oauthConsents/{consentId} {
      allow read, write: if false;
    }

    match /{document=**} {
      allow read, write: if adminUser();
    }

  }
}
