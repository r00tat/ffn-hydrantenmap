    "circle-to-polygon": "^2.2.0",
    "csv-parse": "^7.0.2",
    "csv-stringify": "^6.8.3",
    "dompurify": "^3.4.13",
    "fflate": "^0.8.2",
    "firebase": "12.17.1",
    "firebase-admin": "^14.2.0",
    "firebaseui": "^6.1.0",
    "geofire-common": "^6.0.0",
    "google-auth-library": "^11.0.2",
    "haversine-distance": "^1.2.4",
    "html2pdf.js": "^0.14.0",
    "jose": "^6.2.8",
    "kdbush": "^4.1.0",
    "leaflet": "^1.9.4",
    "leaflet-geometryutil": "^0.10.3",
    "leaflet-rotatedmarker": "^0.2.0",
    "leaflet.heat": "^0.2.0",
    "leaflet.markercluster": "^1.5.3",
    "lodash.debounce": "^4.0.8",
    "marked": "^18.0.9",
    "mathjs": "^15.2.0",
    "modern-screenshot": "^4.7.0",
    "moment": "^2.30.1",
    "moment-timezone": "^0.6.3",
    "mui-color-input": "^9.0.0",
    "nayuki-qr-code-generator": "^1.8.0",
    "next": "16.3.1",
    "next-auth": "^5.0.0-beta.32",
    "next-intl": "^4.13.7",
    "pdf-lib": "^1.17.1",
    "pdfjs-dist": "^6.2.108",
    "proj4": "^2.21.0",
    "qrcode.react": "^4.2.0",
    "react": "^19.2.7",
    "react-dom": "19.2.8",
    "react-firebase-hooks": "^5.1.1",
    "react-google-one-tap-login": "^0.1.1",
    "react-leaflet": "^5.0.0",
    "react-markdown": "^10.1.0",
    "remark-directive": "^4.0.0",
    "remark-gfm": "^4.0.1",
    "server-only": "^0.0.1",
    "sharp": "^0.35.3",
    "simplify-js": "^1.2.4",
    "unist-util-visit": "^5.1.0"
  },
  "devDependencies": {
    "@eslint/compat": "^2.1.0",
    "@playwright/test": "^1.62.1",
    "@testing-library/jest-dom": "^7.0.1",
    "@testing-library/react": "^16.3.2",
    "@testing-library/user-event": "^14.6.5",
    "@types/circle-to-polygon": "^2.2.3",
    "@types/leaflet": "^1.9.22",
    "@types/lodash.debounce": "^4.0.9",
    "@types/node": "^24.10.4",
    "@types/react": "19.2.18",
    "@types/web-bluetooth": "^0.0.21",
    "@vitejs/plugin-react": "^6.0.5",
    "@vitest/coverage-v8": "^4.1.11",
    "baseline-browser-mapping": "^2.11.15",
    "esbuild-wasm": "^0.28.2",
    "eslint": "^9.39.5",
    "eslint-config-next": "16.3.1",
    "jsdom": "^30.0.1",
    "raw-loader": "^4.0.2",
    "serwist": "^9.0.12",
    "ts-node": "^10.9.2",
    "typescript": "^6.0.3",
    "typescript7": "npm:typescript@^7.0.2",
    "vitest": "^4.1.10"
  },
  "overrides": {
    "firebase": "12.17.1",
    "postcss": "^8.5.10",
    "@types/react": "19.2.18",
    "fast-xml-parser": "5.7.0",
    "uuid": "14.0.0",
    "@xmldom/xmldom": "^0.9.1",
    "minimatch": "10.2.4",
    "http-proxy-agent": "^7.0.0",
    "node-domexception": "npm:noop-package",
    "typescript-eslint": "8.59.0",
    "eslint-plugin-react-hooks": "7.0.1",
    "mui-color-input": {
      "@mui/material": "$@mui/material"
    },
    "@simplewebauthn/browser": "$@simplewebauthn/browser",
    "@simplewebauthn/server": "$@simplewebauthn/server"
  }
}
