{
  "name": "ffn-map",
  "description": "Hydrantenkarte der Feuerwehr Neusiedl am See",
  "license": "MPL-2.0",
  "scripts": {
    "dev": "next dev",
    "dev:https": "next dev --experimental-https",
    "build": "next build",
    "start": "next start",
    "lint": "npx eslint",
    "clean:cache": "rm -rf .next/cache/turbopack .next/dev/cache/turbopack",
    "tfvars:dev": "scripts/cloud-run-tfvars.sh --env dev",
    "tfvars:prod": "scripts/cloud-run-tfvars.sh --env prod",
    "extract": "node_modules/typescript/bin/tsc --outDir dist src/server/harparser && node dist/server/harparser.js",
    "import": "node_modules/typescript/bin/tsc --outDir dist src/server/firestore-import && node dist/server/firestore-import.js",
    "exportImport": "node_modules/typescript/bin/tsc --outDir dist src/server/export-import && node dist/server/export-import.js",
    "clusterHydrants": "node_modules/typescript/bin/tsc --outDir dist src/server/hydrant-geohash && node dist/server/hydrant-geohash.js",
    "updateClusters": "node_modules/typescript/bin/tsc --outDir dist src/server/cluster-import && node dist/server/cluster-import.js",
    "terrainImport": "node_modules/typescript/bin/tsc --outDir dist src/server/terrain/terrainImport.ts src/epsg.d.ts --ignoreConfig --target es2022 --moduleResolution node16 --module node16 --esModuleInterop --types node,geojson --skipLibCheck && node dist/server/terrain/terrainImport.js",
    "terrainCalibrate": "node_modules/typescript/bin/tsc --outDir dist src/server/terrain/terrainCalibrate.ts src/epsg.d.ts --ignoreConfig --target es2022 --moduleResolution node16 --module node16 --esModuleInterop --types node,geojson --skipLibCheck && node dist/server/terrain/terrainCalibrate.js",
    "extractStreckenkilometer": "node_modules/typescript/bin/tsc --ignoreConfig --target es2022 --moduleResolution node16 --module node16 --esModuleInterop --types node --skipLibCheck --outDir dist src/server/streckenkilometer-extract.ts && node dist/streckenkilometer-extract.js",
    "docs:screenshots": "playwright test --config=playwright/playwright.config.ts",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:coverage": "vitest run --coverage",
    "typecheck": "node_modules/typescript7/bin/tsc --noEmit",
    "check": "npm run typecheck && npx eslint && vitest run && next build",
    "build:android": "capacitor/build.sh",
    "build:android:release": "capacitor/build.sh release",
    "build:android:bundle": "capacitor/build.sh bundle",
    "install:android": "npm run build:android && adb install -r capacitor/android/app/build/outputs/apk/debug/app-debug.apk",
    "install:android:release": "npm run build:android:release && adb install -r capacitor/android/app/build/outputs/apk/release/app-release.apk",
    "install:android:prod": "(cd capacitor && npx cap sync android) && (cd capacitor/android && ./gradlew assembleRelease -PappVersionCode=$(git rev-list --count HEAD) -PappVersionName=$(git describe --tags --abbrev=0 --match='v*' | sed 's/^v//')) && adb install -r capacitor/android/app/build/outputs/apk/release/app-release.apk",
    "logs:android": "adb logcat -v time Capacitor:V Capacitor/Plugin:V chromium:V CapacitorBluetoothLe:V RadiacodeFg:V RadiacodeBT:V RadiacodeBTIo:V DataBufDecoder:* RadiacodeTrack:* Firestore:W Firestore:E FirebaseAuth:W *:S"
  },
  "dependencies": {
    "@auth/core": "^0.41.3",
    "@capacitor-community/bluetooth-le": "^8.3.0",
    "@capacitor-firebase/authentication": "^8.4.0",
    "@capacitor-firebase/crashlytics": "^8.4.0",
    "@capacitor/app": "^8.1.1",
