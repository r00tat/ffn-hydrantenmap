{
  "name": "einsatzkarte-extension",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "scripts": {
    "dev": "wxt",
    "dev:prod": "EXT_ENV_LOCAL=1 wxt --mode production",
    "build": "wxt prepare && tsc --noEmit && wxt build",
    "build:prod": "wxt prepare && tsc --noEmit && EXT_ENV_LOCAL=1 wxt build && node scripts/package.mjs",
    "test": "wxt prepare && vitest run",
    "postinstall": "wxt prepare",
    "publish:cws": "npm run build:prod && node scripts/publish-cws.mjs"
  },
  "dependencies": {
    "@emotion/react": "^11.14.0",
    "@emotion/styled": "^11.14.1",
    "@mui/icons-material": "^9.5.0",
    "@mui/material": "^9.5.0",
    "firebase": "13.2.0",
    "react": "^19.3.1",
    "react-dom": "^19.3.1"
  },
  "devDependencies": {
    "@types/chrome": "^0.3.7",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@wxt-dev/module-react": "^1.2.2",
    "chrome-webstore-upload": "^4.0.3",
    "crx3": "^2.0.0",
    "jsdom": "^30.1.3",
    "typescript": "^6.0.3",
    "vite": "^8.3.5",
    "vitest": "^5.1.0",
    "wxt": "^0.21.5"
  },
  "overrides": {
    "typescript-eslint": "8.72.1",
    "@grpc/grpc-js": "^1.14.6"
  }
}
